<?xml version="1.0" encoding="UTF-8"?>
<!--  해당 xml에서 사용할 태그 규칙 지정 dtd
 	mybatis 태그 규칙을 적용하기 위해 mybatis에서 제공하는 dtd를 적 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <!--  특정 레파지토리 인터페이스와 연결 설정 -->
 <mapper namespace = "com.jinanging.spring.ex.database.repository.usedGoodsRepository">
 	
 
 	<!--  연결된 Repository 의 특정 메소드에 대한 구현 query -->
 	<select id = "selectUsedGoodsList"
 	resultType = "com.jinanging.spring.ex.database.domain.UsedGoods">
 		SELECT 
 			 `id`
            , `sellerId`
            , `title`
            , `price`
            , `description`
            , `image`
            , `createdAt`
            , `updatedAt`
 		FROM 
 			`used_goods`
 	</select>
 </mapper>